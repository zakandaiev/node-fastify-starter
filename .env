# GENERAL
# every variable name should start with APP_
# use console.log(process.env.APP_*) to debug it

# APP MODE
APP_MODE=prod

# APP HOST
APP_HOST=#localhost:4173

# APP LOG
APP_LOG_LEVEL=info

# APP PROXY
APP_PROXY_TRUST_HOPS=1

# APP DOCS
APP_DOCS_PREFIX=/api-docs

# AUTH
APP_JWT_ACCESS_SECRET=JWT_ACCESS_SECRET
APP_JWT_REFRESH_SECRET=JWT_REFRESH_SECRET
APP_JWT_ACCESS_TTL=10m
APP_JWT_REFRESH_TTL=14d

# COOKIE
APP_COOKIE_SECRET=COOKIE_SECRET

# CORS
APP_CORS_ALLOWED_HOSTS=#localhost:5173
APP_CORS_ALLOWED_METHODS=DELETE,GET,HEAD,OPTIONS,PATCH,POST,PUT

# RATE LIMIT
APP_RATELIMIT_CACHE_PREFIX=rate-limit:

# DATABASE
APP_DATABASE_HOST=127.0.0.1
APP_DATABASE_PORT=3306
APP_DATABASE_NAME=test
APP_DATABASE_USER=admin
APP_DATABASE_PASSWORD=admin
APP_DATABASE_CACHE_PREFIX=database:
APP_DATABASE_CACHE_TTL=1h

# REDIS
APP_REDIS_HOST=127.0.0.1
APP_REDIS_PORT=6379
APP_REDIS_USER=
APP_REDIS_PASSWORD=
APP_REDIS_RECONNECT_COOLDOWN=5m
APP_REDIS_RECONNECT_DELAY=5s

# PAGINATION
APP_PAGINATION_LIMIT=10
APP_PAGINATION_MAX_LIMIT=100

# UPLOAD
APP_UPLOAD_EXTENSIONS=jpg,jpeg,png,gif,svg,webp,pdf,txt,zip,rar
APP_UPLOAD_MAX_SIZE=10485760 # 10MB

# REQUEST
APP_REQUEST_DELAY_MS=0
APP_REQUEST_TIMEOUT_MS=15000

# LOGGER
APP_LOGGER_CACHE_PREFIX=logger:
APP_LOGGER_CACHE_TTL=1h
APP_LOGGER_TELEGRAM_TOKEN=
APP_LOGGER_TELEGRAM_CHAT_ID=
APP_LOGGER_TELEGRAM_ENABLE=false

# EXTERNAL REQUEST DEMO
APP_EXTERNAL_REQUEST_DEMO_API=https://external.api.demo
APP_EXTERNAL_REQUEST_DEMO_TOKEN=123abc
