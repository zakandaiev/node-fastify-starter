{
  "name": "node-fastify-starter",
  "version": "2.0.0",
  "private": false,
  "author": "Oleksandr Zakandaiev",
  "description": "Node.js Fastify Starter is a boilerplate kit for building modern backend applications",
  "keywords": [
    "nodejs",
    "fastify",
    "mariadb",
    "redis",
    "swagger",
    "docker",
    "starter",
    "boilerplate",
    "kit",
    "javascript",
    "js",
    "esm"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/zakandaiev/node-fastify-starter"
  },
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=26.13"
  },
  "imports": {
    "#root/*": "./*",
    "#config/*": "./src/config/*",
    "#core/*": "./src/core/*",
    "#enums/*": "./src/enums/*",
    "#modules/*": "./src/modules/*",
    "#schemas/*": "./src/schemas/*",
    "#utils/*": "./src/utils/*"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "dev:debug": "node --watch --inspect src/server.js",
    "dev:worker": "node --watch src/worker.js",
    "start": "node src/server.js",
    "start:worker": "node src/worker.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "node --test \"tests/**/*.test.js\"",
    "test:unit": "node --test \"tests/unit/**/*.test.js\"",
    "test:coverage": "node --test --experimental-test-coverage \"tests/**/*.test.js\"",
    "test:watch": "node --test --watch \"tests/**/*.test.js\"",
    "migrate:up": "node scripts/migrate.js --direction=up",
    "migrate:down": "node scripts/migrate.js --direction=down",
    "migrate:status": "node scripts/migrate.js --direction=status",
    "migrate:make": "node scripts/migrate.js --direction=make",
    "migrate:verify": "node scripts/migrate.js --direction=verify",
    "migrate:fresh": "node scripts/migrate.js --direction=fresh",
    "seed:up": "node scripts/migrate.js --type=seed --direction=up",
    "seed:down": "node scripts/migrate.js --type=seed --direction=down",
    "job": "node scripts/job.js",
    "keygen": "node scripts/keygen.js",
    "openapi": "node scripts/openapi.js",
    "api:index": "node scripts/api-index.js",
    "alert:test": "node scripts/alert-test.js",
    "check": "npm run lint && npm test"
  },
  "overrides": {
    "eslint": "$eslint"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-import-resolver-alias": "^1.1.2",
    "eslint-plugin-import": "^2.32.0",
    "globals": "^17.14.0"
  },
  "dependencies": {
    "@fastify/autoload": "^6.5.1",
    "ajv": "^8.20.0",
    "fastify": "^5.12.8",
    "fastify-plugin": "^6.0.1",
    "mysql2": "^3.24.6",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0"
  }
}
