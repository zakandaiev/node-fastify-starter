# GENERAL
# every variable name should start with APP_
# use console.log(process.env.APP_*) to debug it

# APP
APP_MODE=prod
APP_PROTOCOL=https
APP_HOST=

# BOOTSTRAP
APP_ADMIN_EMAILS=

# WORKER
APP_HEALTH_PORT=

