APP_DATABASE_HOST=127.0.0.1
APP_DATABASE_PORT=3306
APP_DATABASE_NAME=
APP_DATABASE_USER=
APP_DATABASE_PASSWORD=

# REDIS
APP_REDIS_HOST=127.0.0.1
APP_REDIS_PORT=6379
