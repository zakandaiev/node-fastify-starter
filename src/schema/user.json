{
  "#example": {
    "id": "id-hash",
    "email": "dummy@email.com",
    "name": "Dummy Name",
    "phone": null,
    "avatar": "APP_HOST/upload/id-file-hash",
    "role": "user"
  },
  "#filter": {
    "email": {
      "type": "text",
      "isExact": true
    },
    "name": {
      "type": "text"
    },
    "phone": {
      "type": "text",
      "isExact": true
    },
    "role": {
      "type": "options",
      "isMultiple": false,
      "options": [
        {
          "value": "admin",
          "label": "Admin",
          "isChecked": false
        },
        {
          "value": "user",
          "label": "User",
          "isChecked": false
        }
      ]
    }
  },
  "#sort": [
    {
      "value": "name:asc",
      "label": "User name (A-Z)",
      "isChecked": false
    },
    {
      "value": "name:desc",
      "label": "User name (Z-A)",
      "isChecked": false
    },
    {
      "value": "dateCreated:asc",
      "label": "Oldest first",
      "isChecked": false
    },
    {
      "value": "dateCreated:desc",
      "label": "Newest first",
      "isChecked": false
    }
  ],
  "id": {
    "type": "string",
    "description": "User identifier",
    "minLength": 16,
    "maxLength": 64
  },
  "email": {
    "type": "string",
    "format": "email",
    "description": "User email",
    "maxLength": 256
  },
  "password": {
    "type": "string",
    "format": "password",
    "description": "User password",
    "minLength": 8,
    "maxLength": 256
  },
  "name": {
    "type": "string",
    "description": "User name",
    "minLength": 2,
    "maxLength": 256
  },
  "phone": {
    "type": "string",
    "description": "User phone",
    "minLength": 8,
    "maxLength": 128
  },
  "avatar": {
    "type": "string",
    "format": "binary",
    "description": "File binary"
  },
  "role": {
    "type": "string",
    "description": "User role",
    "maxLength": 64
  },
  "isEnabled": {
    "type": "boolean",
    "description": "Is user enabled"
  },
  "dateCreated": {
    "type": "string",
    "format": "date-time",
    "description": "User create date"
  },
  "dateEdited": {
    "type": "string",
    "format": "date-time",
    "description": "User last edit date"
  }
}
